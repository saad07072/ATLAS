GEMINI_API_KEY=
LLM_PROVIDER=gemini

# Supabase PostgreSQL connection string (server-side only).
DATABASE_URL=
SUPABASE_URL=
# Optional legacy HS256 signing secret; keep server-side only. Prefer JWKS-backed asymmetric signing keys.
SUPABASE_JWT_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/api/v1/google/oauth/callback
# Generate a Fernet key; required to encrypt persisted Google credentials.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_API_TIMEOUT_SECONDS=15

GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Set either the private-key file path or GITHUB_PRIVATE_KEY for an inline PEM.
GITHUB_PRIVATE_KEY_PATH=backend/secrets/your-github-app.private-key.pem
GITHUB_PRIVATE_KEY=
GITHUB_API_TIMEOUT_SECONDS=15

# Security Hardening & Rate Limiting (Phase 15)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=60/minute
RATE_LIMIT_WORKFLOWS=30/minute
RATE_LIMIT_CONFIRMATIONS=30/minute
RATE_LIMIT_OAUTH=20/minute
RATE_LIMIT_AUTHENTICATED_DEFAULT=120/minute
RATE_LIMIT_UNAUTHENTICATED_DEFAULT=60/minute

# Reverse Proxy Trust (Set to true only if behind a verified reverse proxy like Nginx or Cloudflare)
TRUST_PROXY_HEADERS=false
TRUSTED_PROXIES=["127.0.0.1", "::1"]

# CORS & Transport Security
CORS_ALLOW_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
ENABLE_HSTS=false
MAX_REQUEST_BODY_BYTES=1048576