GEMINI_API_KEY=
LLM_PROVIDER=gemini

# Supabase PostgreSQL connection string (server-side only).
DATABASE_URL=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/api/v1/google/oauth/callback
# Generate a Fernet key; required to encrypt persisted Google credentials.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_DB_PATH=backend/data/google_tokens.sqlite3
GOOGLE_API_TIMEOUT_SECONDS=15

GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Set either the private-key file path or GITHUB_PRIVATE_KEY for an inline PEM.
GITHUB_PRIVATE_KEY_PATH=backend/secrets/your-github-app.private-key.pem
GITHUB_PRIVATE_KEY=
GITHUB_API_TIMEOUT_SECONDS=15